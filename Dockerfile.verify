# Verification only; not a deployment image. Linux gets its own dependency tree.
FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
RUN npm install --global pnpm@12.11.2
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/db/package.json ./packages/db/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/core/package.json ./packages/core/
COPY packages/jobs/package.json ./packages/jobs/
COPY packages/money/package.json ./packages/money/
COPY packages/platform/package.json ./packages/platform/
COPY packages/ui/package.json ./packages/ui/
COPY patches ./patches
RUN pnpm install --frozen-lockfile
RUN pnpm exec playwright install --with-deps chromium
# The controlled HTTPS fixtures generate ephemeral certificates at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY tests ./tests
COPY infra/provision-maintenance-roles.sql ./infra/
COPY .gitignore biome.json knip.json turbo.json tsconfig.base.json vitest.config.ts vitest.integration.config.ts playwright.config.ts ./
RUN chmod +x scripts/check-negative-types.mjs
RUN pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm test:negative && pnpm build && node scripts/check-artifacts.mjs
RUN ./scripts/check-negative-types.mjs
RUN AARILI_PRIVATE_PROBE=aarili-private-probe-issue-2 pnpm --filter @aarili/web build && node scripts/check-artifacts.mjs
# Real Testcontainers checks require the runtime socket, never a build-time daemon.
CMD ["pnpm", "verify"]
