{
  "name": "@aarili/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./money-fixture-client": {
      "types": "./dist/money-fixture-client.d.ts",
      "import": "./dist/money-fixture-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@aarili/auth": "workspace:*",
    "@aarili/contracts": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.13",
    "@aarili/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
