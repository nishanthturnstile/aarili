{
  "name": "@aarili/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./foundation-runtime": {
      "types": "./dist/foundation-runtime.d.ts",
      "import": "./dist/foundation-runtime.js"
    },
    "./draft-fixture": {
      "types": "./dist/draft-fixture.d.ts",
      "import": "./dist/draft-fixture.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aarili/auth": "workspace:*",
    "@aarili/contracts": "workspace:*",
    "@aarili/core": "workspace:*",
    "@aarili/db": "workspace:*",
    "@aarili/platform": "workspace:*",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
