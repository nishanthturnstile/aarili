{
  "name": "@aarili/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./job-principal": {
      "types": "./dist/job-principal.d.ts",
      "import": "./dist/job-principal.js"
    },
    "./delivery-guard": {
      "types": "./dist/delivery-guard.d.ts",
      "import": "./dist/delivery-guard.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aarili/contracts": "workspace:*",
    "@aarili/db": "workspace:*",
    "@aarili/platform": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "uuid": "14.0.3",
    "@aarili/core": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  }
}
