{
  "name": "@aarili/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./money-fixture": {
      "types": "./dist/money-fixture.d.ts",
      "import": "./dist/money-fixture.js"
    },
    "./journal": {
      "types": "./dist/journal.d.ts",
      "import": "./dist/journal.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js"
    },
    "./restore": {
      "types": "./dist/restore.d.ts",
      "import": "./dist/restore.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "import": "./dist/schedules.js"
    },
    "./request-binding": {
      "types": "./dist/request-binding.d.ts",
      "import": "./dist/request-binding.js"
    },
    "./drafts": {
      "types": "./dist/drafts.d.ts",
      "import": "./dist/drafts.js"
    },
    "./request-version": {
      "types": "./dist/request-version.d.ts",
      "import": "./dist/request-version.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aarili/db": "workspace:*",
    "@aarili/contracts": "workspace:*",
    "@aarili/money": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
