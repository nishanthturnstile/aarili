{
  "name": "@aarili/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./abuse-limiter": {
      "types": "./dist/abuse-limiter.d.ts",
      "default": "./dist/abuse-limiter.js"
    },
    "./database-health": {
      "types": "./dist/database-health.d.ts",
      "default": "./dist/database-health.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
