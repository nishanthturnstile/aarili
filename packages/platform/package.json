{
  "name": "@aarili/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./media-validation": {
      "types": "./dist/media-validation.d.ts",
      "import": "./dist/media-validation.js"
    },
    "./abuse-limiter": {
      "types": "./dist/abuse-limiter.d.ts",
      "default": "./dist/abuse-limiter.js"
    },
    "./database-health": {
      "types": "./dist/database-health.d.ts",
      "default": "./dist/database-health.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./media-storage": {
      "types": "./dist/media-storage.d.ts",
      "import": "./dist/media-storage.js"
    },
    "./document-storage": {
      "types": "./dist/document-storage.d.ts",
      "import": "./dist/document-storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@sentry/node": "11.8.0",
    "@t3-oss/env-core": "0.13.11",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.2.3",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
