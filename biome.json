{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.ts",
      "!**/dist",
      "!**/.next",
      "!**/.next-ui",
      "!tests/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/public/pwa/offline.css"],
      "formatter": { "enabled": false }
    },
    {
      "includes": [
        "scripts/local-infra.mjs",
        "scripts/migrate.mjs",
        "scripts/install-command-fixture.mjs",
        "scripts/foundation-money.mjs",
        "scripts/test-support/owner-restart.mjs",
        "scripts/test-support/owner-recovery-process.mjs"
      ],
      "linter": {
        "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } }
      }
    }
  ]
}
