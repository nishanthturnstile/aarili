{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/test-support/owner-restart.mjs",
        "scripts/test-support/owner-recovery-process.mjs",
        "scripts/test-support/google-transport.mjs",
        "scripts/test-support/runtime-child.mjs",
        "tests/*.test.ts",
        "tests/*.test.mjs"
      ],
      "project": ["scripts/**/*.mjs", "tests/**/*.{ts,mjs}"],
      "ignore": ["tests/fixtures/**"]
    },
    "apps/web": {
      "ignoreExportsUsedInFile": true,
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/worker": {
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
