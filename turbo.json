{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["npm_execpath"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NODE_ENV", "NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "AARILI_SYNTHETIC_AUTH",
        "AUTH_ORIGIN",
        "BETTER_AUTH_SECRET",
        "SETUP_TOKEN",
        "AUTH_CAPTURE_DIRECTORY",
        "AARILI_UI_VERIFICATION"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
