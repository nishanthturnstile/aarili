{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "npm_execpath",
    "OUTBOUND_EFFECTS",
    "AARILI_OWNER_UI_TRIAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NODE_ENV", "NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "AARILI_DESIGN_TRIAL",
        "DATABASE_URL",
        "AARILI_SYNTHETIC_AUTH",
        "AUTH_ORIGIN",
        "BETTER_AUTH_SECRET",
        "SETUP_TOKEN",
        "AUTH_CAPTURE_DIRECTORY",
        "AARILI_UI_VERIFICATION",
        "AUTH_GOOGLE_ENABLED",
        "AUTH_GOOGLE_ENVIRONMENT",
        "AUTH_GOOGLE_APPROVED_ORIGIN",
        "AUTH_GOOGLE_ALLOWED_EMAILS",
        "GOOGLE_DEV_CLIENT_ID",
        "GOOGLE_DEV_CLIENT_SECRET",
        "GOOGLE_PROD_CLIENT_ID",
        "GOOGLE_PROD_CLIENT_SECRET",
        "TEST_GOOGLE_TRANSPORT_ORIGIN",
        "NODE_OPTIONS"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
