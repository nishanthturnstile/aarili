# Server-only configuration. Never use NEXT_PUBLIC_* for auth or database values.
NODE_ENV=development
DATABASE_URL=postgresql://app_user:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@127.0.0.1:55432/aarili
# Off unless explicitly preparing synthetic loopback verification. No live email.
AARILI_SYNTHETIC_AUTH=false
AUTH_ORIGIN=http://127.0.0.1:3000
# Write independently generated cryptographic values (at least 32 bytes) to the
# ignored private .env.local, never this example or terminal/chat logs.
BETTER_AUTH_SECRET=
SETUP_TOKEN=
# Absolute private directory outside the checkout; restrict ACLs on Windows.
AUTH_CAPTURE_DIRECTORY=
